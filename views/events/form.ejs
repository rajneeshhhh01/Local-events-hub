<%- include('../partials/header') %>

<p><a href="/events">&larr; All events</a></p>

<h1><%= isEdit ? 'Edit event' : 'Add event' %></h1>

<%- include('../partials/errors') %>

<form action="<%= isEdit ? '/events/' + event.id + '/edit' : '/events' %>" method="POST" class="box js-check" id="eventForm" novalidate>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <!-- Used for the AI log -->
  <input type="hidden" name="ai_id" id="aiId" value="<%= event.ai_id || '' %>">
  <input type="hidden" name="ai_choice" id="aiChoice" value="<%= event.ai_choice || '' %>">

  <div class="field">
    <label for="title">Title</label>
    <input type="text" id="title" name="title" value="<%= event.title || '' %>" required minlength="3" maxlength="120">
  </div>

  <div class="form-row">
    <div class="field">
      <label for="category_id">Category</label>
      <select id="category_id" name="category_id" required>
        <option value="">Pick one</option>
        <% categories.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= event.category_id == c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }) %>
      </select>
    </div>

    <div class="field">
      <label for="venue">Venue</label>
      <input type="text" id="venue" name="venue" value="<%= event.venue || '' %>" required minlength="3" maxlength="150">
    </div>
  </div>

  <div class="form-row">
    <div class="field">
      <label for="event_date">Date</label>
      <input type="date" id="event_date" name="event_date" value="<%= event.event_date || '' %>" required>
    </div>
    <div class="field">
      <label for="event_time">Time</label>
      <input type="time" id="event_time" name="event_time" value="<%= event.event_time || '' %>" required>
    </div>
  </div>

  <div class="form-row three">
    <div class="field">
      <label for="total_tickets">Total tickets</label>
      <input type="number" id="total_tickets" name="total_tickets" min="1" max="10000" value="<%= event.total_tickets || '' %>" required>
    </div>
    <div class="field">
      <label for="price">Price ($, 0 = free)</label>
      <input type="number" id="price" name="price" min="0" max="9999" step="0.01" value="<%= event.price %>" required>
    </div>
    <div class="field">
      <label for="status">Status</label>
      <select id="status" name="status">
        <option value="open" <%= event.status == 'open' ? 'selected' : '' %>>Open</option>
        <option value="closed" <%= event.status == 'closed' ? 'selected' : '' %>>Closed</option>
      </select>
    </div>
  </div>

  <div class="ai-box">
    <h2>AI writing helper</h2>
    <p class="small">Type some keywords. The helper makes 3 drafts. You must read and change the text before you save.</p>
    <div class="ai-row">
      <label for="keywords" class="sr-only">Keywords</label>
      <input type="text" id="keywords" placeholder="Example: live music, food trucks, kids games" maxlength="200">
      <button type="button" class="btn btn-light" id="aiBtn">Get drafts</button>
    </div>
    <p class="ai-status" id="aiStatus" aria-live="polite"></p>
    <div id="aiDrafts"></div>
    <p class="warning">AI-generated content requires human review.</p>
  </div>

  <div class="field">
    <label for="description">Description</label>
    <textarea id="description" name="description" rows="7" required minlength="20" maxlength="2000"><%= event.description || '' %></textarea>
  </div>

  <!-- Shows only when AI text is used -->
  <div class="field check-row" id="aiCheckRow" <%= event.ai_choice ? '' : 'hidden' %>>
    <input type="checkbox" id="ai_checked" name="ai_checked" value="yes" <%= event.ai_choice ? 'required' : '' %>>
    <label for="ai_checked">I read the AI text and I checked it is correct.</label>
  </div>

  <div class="actions">
    <button type="submit" class="btn"><%= isEdit ? 'Save changes' : 'Add event' %></button>
    <a href="/events" class="btn btn-light">Cancel</a>
  </div>
</form>

<script src="/js/ai.js"></script>

<%- include('../partials/footer') %>
