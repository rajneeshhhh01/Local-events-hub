<%- include('../partials/header') %>

<h1>Categories</h1>
<%- include('menu') %>

<div class="two-col">
  <section class="box">
    <h2>All categories</h2>
    <% if (categories.length == 0) { %>
      <p class="empty">No categories yet.</p>
    <% } else { %>
      <ul class="plain-list">
        <% categories.forEach(function (c) { %>
          <li>
            <span><%= c.name %> <span class="small">(<%= c.event_count %> events)</span></span>
            <% if (c.event_count == 0) { %>
              <form action="/admin/categories/<%= c.id %>/delete" method="POST" class="inline js-confirm" data-msg="Delete this category?">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-small btn-danger">Delete</button>
              </form>
            <% } %>
          </li>
        <% }) %>
      </ul>
    <% } %>
  </section>

  <section class="box">
    <h2>Add category</h2>
    <%- include('../partials/errors') %>
    <form action="/admin/categories" method="POST" class="js-check" novalidate>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field">
        <label for="name">Name</label>
        <input type="text" id="name" name="name" required minlength="2" maxlength="60">
      </div>
      <button type="submit" class="btn">Add</button>
    </form>
  </section>
</div>

<%- include('../partials/footer') %>
